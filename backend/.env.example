PORT=3000
JWT_SECRET=
# Local: mantenha DB_* no seu .env atual.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ediagnostico
DB_USER=ediag_app
DB_PASSWORD=
# Online: configure DATABASE_URL como segredo no provedor, incluindo os
# parâmetros TLS recomendados pelo PostgreSQL contratado (ex.: sslmode=verify-full).
DATABASE_URL=
# DB_SSL aplica-se somente à configuração DB_*.
DB_SSL=false
# Origens web extras separadas por vírgula. O Android http://localhost já é aceito.
CORS_ORIGINS=
# Pasta com subpastas videos/ e images/ em armazenamento persistente.
MEDIA_ROOT=
